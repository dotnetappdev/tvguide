<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Finding Channels DVR servers on the home network (mDNS). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Radio keeps playing when you leave the app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Reminder notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- A TV app: no touchscreen, D-pad remote. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- Works on Ethernet-connected boxes too. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <!-- Broadcaster apps the player can open when a channel has no stream (package visibility on Fire OS 8+). -->
    <queries>
        <package android:name="bbc.iplayer.android" />
        <package android:name="uk.co.bbc.iplayer" />
        <package android:name="air.ITVMobilePlayer" />
        <package android:name="com.itv.hub.firetv" />
        <package android:name="com.stv.stvplayer" />
        <package android:name="uk.co.stv.player" />
        <package android:name="com.channel4.ondemand" />
        <package android:name="uk.co.channel4.android.tv" />
        <package android:name="com.channel5.my5" />
        <package android:name="com.channel5.androidtv" />
        <package android:name="com.nowtv.player" />
        <package android:name="com.nowtv.firetv" />
        <package android:name="uk.co.uktv.dave" />
        <package android:name="com.uktv.player" />
        <!-- Voice search (speech recogniser), where the device has one. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".TvGuideApplication"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.TvGuide">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.RadioService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <receiver android:name=".reminders.ReminderReceiver" android:exported="false" />
        <receiver android:name=".reminders.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
