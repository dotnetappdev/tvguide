<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Live TV playlists from home servers (Channels DVR, Jellyfin, TVHeadend) and many IPTV sources use plain http. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Finds Channels DVR servers on the home network. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_channels_dvr._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>TV Guide finds and connects to your live TV server (such as Channels DVR) on your home network to play channels and read the TV guide from your aerial.</string>
</dict>
</plist>
